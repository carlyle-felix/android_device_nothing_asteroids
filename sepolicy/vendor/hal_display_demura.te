type hal_display_demura_service, service_manager_type;

attribute hal_display_demura;
attribute hal_display_demura_server;

hal_server_domain(hal_display_demura_default, hal_display_demura)

add_service(hal_display_demura_default, hal_display_demura_service)
binder_call(hal_display_demura_default, servicemanager)

neverallow { domain -hal_display_demura_default } hal_display_demura_service:service_manager { add };